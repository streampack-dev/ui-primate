export interface Input {
  meta?: import("#lib/meta.ts").Head;
  /** The author's display name, from their posts; "" when they have none published. */
  name: string;
  count: string;
  posts: any[];
  pages: string;
  prev: string | null;
  next: string | null;
}

<page-meta meta=input.meta/>
<section class="py-8 md:py-12">
  <div class="max-w-3xl mx-auto px-6 md:px-8">
    <header class="mb-10">
      <div class="border-t-2 border-amber animate-rule-draw"/>
      <div class="pt-6 pb-8 border-b border-border/40">
        <p class="section-label text-amber mb-3">Author</p>
        <h1 class="font-display text-foreground leading-tight submit-title">${input.name || "Author"}</h1>
        <if=input.posts.length><p class="author-count text-muted-foreground text-sm mt-2">${input.count}</p></if>
      </div>
    </header>
    <if=(input.posts.length === 0)>
      <div class="py-12 text-center">
        <p class="section-label form-label-text mb-3">No published posts</p>
        <p class="text-muted-foreground text-sm">There's nothing by this author to read here.</p>
      </div>
    </if>
    <else>
      <for|p, i| of=input.posts by="id"><post-row row=p first=(i === 0)/></for>
    </else>
    <list-pager pages=input.pages prev=input.prev next=input.next/>
  </div>
</section>
