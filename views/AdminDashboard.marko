export interface Input {
  meta?: import("#lib/meta.ts").Head;
  sections: { href: string; label: string; current: boolean }[];
  csrf: string;
  stats: { label: string; value: string; href: string | null }[];
  categories: { name: string; parent: string | null; posts: number }[];
  tags: { name: string; count: number }[];
  system: string[][];
  opml: { payload?: string; error?: string; said?: string };
}

<page-meta meta=input.meta/>
<admin-shell sections=input.sections>
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 mb-10">
    <for|s| of=input.stats by="label">
      <div class="admin-stat border border-border/40 p-4">
        <if=s.href><a class="block" href=s.href><span class="admin-stat-value block font-display text-3xl text-foreground">${s.value}</span><span class="admin-stat-label section-label form-label-text">${s.label}</span></a></if>
        <else><span class="admin-stat-value block font-display text-3xl text-foreground">${s.value}</span><span class="admin-stat-label section-label form-label-text">${s.label}</span></else>
      </div>
    </for>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 mb-10">
    <section aria-labelledby="admin-categories-heading">
      <div class="flex items-center justify-between mb-4">
        <h2 class="section-label text-amber" id="admin-categories-heading">Categories</h2>
        <a class="section-label form-helper" href="/admin/categories">Manage</a>
      </div>
      <if=(input.categories.length === 0)><p class="text-muted-foreground text-sm">No categories yet.</p></if>
      <else>
        <ul class="admin-categories space-y-2">
          <for|c| of=input.categories by="name">
            <li class="flex justify-between gap-3 text-sm">
              <span><a class="pagelink" href=`/category/${encodeURIComponent(c.name)}`>${c.name}</a><if=c.parent> <span class="text-muted-foreground">in ${c.parent}</span></if></span> <span class="text-muted-foreground">${c.posts} posts</span>
            </li>
          </for>
        </ul>
      </else>
    </section>
    <section aria-labelledby="admin-tags-heading">
      <div class="flex items-center justify-between mb-4">
        <h2 class="section-label text-amber" id="admin-tags-heading">Top Tags</h2>
        <a class="section-label form-helper" href="/tags">All tags</a>
      </div>
      <if=(input.tags.length === 0)><p class="text-muted-foreground text-sm">No tags yet.</p></if>
      <else>
        <div class="admin-tags tags">
          <for|t| of=input.tags by="name"><a class="tag" href=`/tags/${encodeURIComponent(t.name)}`>${t.name} (${t.count})</a></for>
        </div>
      </else>
    </section>
  </div>

  <section class="border-t border-border/40 pt-6 mb-10" id="opml" aria-labelledby="opml-heading">
    <div class="flex items-center justify-between gap-4 mb-3">
      <div>
        <h2 class="section-label text-amber" id="opml-heading">RSS OPML</h2>
        <p class="text-sm text-muted-foreground mt-1">Export active RSS feeds, or import OPML or a list of feed addresses.</p>
      </div>
      <a class="section-label profile-action" href="/admin/rss/opml" download>Export</a>
    </div>
    <if=input.opml.said><p class="form-status" role="status">${input.opml.said}</p></if>
    <form method="post" action="/admin/rss/opml/import" class="mt-3">
      <input type="hidden" name="csrf" value=input.csrf>
      <label class="byline form-label" for="opml-payload">OPML, or feed addresses one to a line</label>
      <textarea class="form-field form-mono text-sm" id="opml-payload" name="payload" rows="5"
        aria-invalid=(input.opml.error ? "true" : false) aria-describedby=(input.opml.error ? "opml-error" : false)>${input.opml.payload ?? ""}</textarea>
      <if=input.opml.error><p class="form-error" id="opml-error" role="alert">${input.opml.error}</p></if>
      <button type="submit" class="auth-button mt-3">Import</button>
    </form>
  </section>

  <if=input.system.length>
    <section class="border-t border-border/40 pt-6" aria-labelledby="system-heading">
      <h2 class="section-label text-amber mb-4" id="system-heading">System</h2>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3 text-sm">
        <for|row| of=input.system by=(r) => r[0]>
          <div class="flex justify-between gap-3 border-b border-border/20 pb-2"><dt class="text-muted-foreground">${row[0]}</dt><dd class="text-foreground">${row[1]}</dd></div>
        </for>
      </dl>
    </section>
  </if>
</admin-shell>
