import type { FreshItem } from "#lib/atlas.ts";
import { type FreshCount, type Kind, type MapData, regionViews } from "#lib/atlas-map.ts";

export interface Input {
  meta?: import("#lib/meta.ts").Head;
  unavailable: boolean;
  map: MapData;
  freshByPlace: Record<string, FreshCount>;
  tags: string[];
  focus: string | null;
  asked: string;
  missed: string | null;
  viewBox: string;
  world: string;
  unit: string;
  zoom: string;
  kinds: { kind: Kind; shape: string; legend: string }[];
  pinKinds: { kind: "article" | "factoid"; shape: string; legend: string }[];
  fresh: { since: string; items: FreshItem[]; more: number; newCount: number; changedCount: number; any: boolean } | null;
}

<!-- The Atlas (ui-pudl#184): the site's tags as places on a map, drawn as SVG where the API laid
     them out, so it works without script (client/atlas.ts adds zoom, pan and find). Every place is
     a link to its tag's page, every pin to its post or factoid. What's found at a place is told by
     shape, never by colour alone: a disc for articles only, a ring for factoids only, a diamond for
     both; close up, a square for each article and a triangle for each factoid; a dot for something
     new, a small ring for something changed. The list of regions and places is the way in without
     the map. -->
<page-meta meta=input.meta/>
<!-- The map is drawn from the API's layout here, not in the route, so its props carry the layout
     once (ui-primate#48). -->
<const/regions=regionViews(input.map, input.focus, input.freshByPlace)/>
<const/placeCount=input.map.places.length/>
<section class="atlas-page py-6 md:py-8">
  <div class="max-w-screen-2xl mx-auto px-4 md:px-8">
    <header class="mb-4">
      <div class="border-t-2 border-amber animate-rule-draw"/>
      <div class="atlas-head pt-5 pb-4 border-b border-border/40">
        <div>
          <p class="section-label text-amber mb-2">Index</p>
          <h1 class="font-display text-foreground leading-tight submit-title">Atlas</h1>
          <p class="atlas-intro text-muted-foreground text-sm mt-2">The site's tags as places: tags used together share a region. ${placeCount} places in ${regions.length} regions.</p>
        </div>
        <form class="atlas-find" action="/atlas" method="get" role="search">
          <label class="sr-only" for="atlas-at">Find a place on the map (a tag)</label>
          <input class="form-field text-sm p-2" id="atlas-at" name="at" type="search" list="atlas-tags" placeholder="Find a place..." value=(input.focus ?? input.asked) autocomplete="off">
          <datalist id="atlas-tags"><for|t| of=input.tags><option value=t/></for></datalist>
          <button type="submit" class="auth-button shrink-0">Find</button>
        </form>
      </div>
    </header>

    <if=input.unavailable>
      <div class="py-12 text-center">
        <p class="section-label form-label-text mb-3">The map is unavailable right now</p>
        <p class="text-muted-foreground text-sm">The news service isn't answering. Try again in a moment.</p>
      </div>
    </if>
    <else-if=(regions.length === 0)>
      <div class="py-12 text-center">
        <p class="section-label form-label-text mb-3">Nothing on the map yet</p>
        <p class="text-muted-foreground text-sm">Places appear once posts or factoids carry tags.</p>
      </div>
    </else-if>
    <else>
      <div class="atlas-layout">
        <section class="atlas" data-atlas data-focus=input.focus aria-labelledby="atlas-map-heading">
          <h2 class="sr-only" id="atlas-map-heading">Map of the site's tags</h2>
          <div class="atlas-hud">
            <details class="atlas-key-box" open>
              <summary class="atlas-key-button">Key</summary>
              <ul class="atlas-legend" aria-label="What the shapes mean">
                <for|k| of=input.kinds>
                  <li class=`atlas-legend-${k.shape}`>
                    <svg class="atlas-key" viewBox="-8 -8 16 16" width="16" height="16" aria-hidden="true">
                      <if=(k.kind === "articles")><circle class="mark mark-disc" r="5.5"/></if>
                      <else-if=(k.kind === "factoids")><circle class="mark mark-ring" r="4.6" style="stroke-width:2.4"/></else-if>
                      <else><path class="mark mark-diamond" d="M0,-7L7,0L0,7L-7,0Z"/></else>
                    </svg>
                    <span class="atlas-legend-shape">${k.shape}:</span> ${k.legend}
                  </li>
                </for>
                <for|k| of=input.pinKinds>
                  <li class=`atlas-legend-${k.shape}`>
                    <svg class="atlas-key" viewBox="-8 -8 16 16" width="16" height="16" aria-hidden="true">
                      <if=(k.kind === "article")><path class="pin-mark pin-mark-article" d="M-4.5,-4.5H4.5V4.5H-4.5Z"/></if>
                      <else><path class="pin-mark pin-mark-factoid" d="M0,-5.6L5.2,3.8L-5.2,3.8Z"/></else>
                    </svg>
                    <span class="atlas-legend-shape">${k.shape}:</span> ${k.legend}
                  </li>
                </for>
                <li class="atlas-legend-dot">
                  <svg class="atlas-key" viewBox="-8 -8 16 16" width="16" height="16" aria-hidden="true"><circle class="badge badge-new" r="4.5"/></svg>
                  <span class="atlas-legend-shape">dot:</span> Something new
                </li>
                <li class="atlas-legend-small-ring">
                  <svg class="atlas-key" viewBox="-8 -8 16 16" width="16" height="16" aria-hidden="true"><circle class="badge badge-changed" r="3.6"/></svg>
                  <span class="atlas-legend-shape">small ring:</span> Something changed
                </li>
              </ul>
            </details>
            <div class="atlas-zoom" role="group" aria-label="Zoom the map" hidden>
              <button class="atlas-zoom-button" type="button" data-atlas-zoom="in" aria-label="Zoom in" title="Zoom in">+</button>
              <button class="atlas-zoom-button" type="button" data-atlas-zoom="out" aria-label="Zoom out" title="Zoom out">−</button>
              <button class="atlas-zoom-button" type="button" data-atlas-zoom="fit">Whole map</button>
            </div>
          </div>
          <if=input.missed><p class="atlas-missed" role="status">No place on the map is called “${input.missed}”.</p></if>
          <svg class=["atlas-map", input.focus && "atlas-framed"] viewBox=input.viewBox data-world=input.world preserveAspectRatio="xMidYMid meet" role="group" aria-label=`Map of the site's tags: ${placeCount} places in ${regions.length} regions` data-zoom=input.zoom style=`--u:${input.unit}`>
            <g class="atlas-world">
              <g class="atlas-regions" aria-hidden="true">
                <for|region| of=regions by="id"><circle class=["region", region.uncharted && "region-uncharted"] cx=region.x cy=region.y r=region.r/></for>
              </g>
              <g class="atlas-places">
                <for|region| of=regions by="id">
                  <g class="atlas-region" role="group" aria-label=region.name>
                    <for|p| of=region.places by="tag">
                      <a class=["place", `place-${p.kind}`, p.minor && "minor", p.major && "major", p.here && "here", p.fresh && "fresh", p.fresh && `fresh-${p.fresh}`] href=p.href data-tag=p.tag data-x=p.x data-y=p.y aria-label=p.label>
                        <title>${p.label}</title>
                        <if=p.fresh><circle class="glow" cx=p.x cy=p.y r=p.glowR style=`--gr:${p.glowR}`/></if>
                        <if=(p.kind === "shared")><path class="mark mark-diamond" d=p.diamond/></if>
                        <else-if=(p.kind === "factoids")><circle class="mark mark-ring" cx=p.x cy=p.y r=p.r style=`stroke-width:${p.ringWidth}`/></else-if>
                        <else><circle class="mark mark-disc" cx=p.x cy=p.y r=p.r/></else>
                        <if=(p.fresh === "new")><circle class="badge badge-new" cx=p.badgeX cy=p.badgeY r="4.5"/></if>
                        <else-if=(p.fresh === "changed")><circle class="badge badge-changed" cx=p.badgeX cy=p.badgeY r="3.6"/></else-if>
                        <text class="label" x=p.x y=p.y dy=p.dy style=`--fs:${p.fs}` aria-hidden="true">${p.tag}</text>
                      </a>
                    </for>
                  </g>
                </for>
              </g>
              <!-- Pins: what's found at each place, shown close up around the place framed or pointed
                   at, and around every place closer still. The places and the list reach the same
                   posts and factoids, so the pins stay out of the tab order and the accessibility
                   tree (hundreds of them would bury the places). -->
              <g class="atlas-pins" aria-hidden="true">
                <for|region| of=regions by="id">
                  <for|p| of=region.places by="tag">
                    <if=(p.pins.length > 0)>
                      <g class=["pins", p.here && "here"] data-for=p.tag>
                        <for|pin, i| of=p.pins><a class=["pin", `pin-${pin.kind}`] href=pin.href data-tag=p.tag data-x=pin.x data-y=pin.y tabindex="-1"><title>${pin.title}</title><path class=["pin-mark", `pin-mark-${pin.kind}`] d=pin.path/></a></for>
                      </g>
                    </if>
                  </for>
                </for>
              </g>
              <g class="atlas-region-names" aria-hidden="true">
                <for|region| of=regions by="id">
                  <text class="region-name above" x=region.x y=region.labelY data-size=region.size>${region.name}</text>
                  <text class=["region-name across", region.small && "small"] x=region.x y=region.y data-size=region.size><for|line| of=region.lines><tspan x=region.x dy=line.dy>${line.text}</tspan></for></text>
                </for>
              </g>
            </g>
          </svg>
        </section>

        <aside class="atlas-side" aria-label="What's new, and the places as a list">
          <if=input.fresh>
            <section class="whats-new" aria-labelledby="whats-new-heading">
              <h2 class="section-label text-amber" id="whats-new-heading">What's new</h2>
              <p class="whats-new-since">Since ${input.fresh.since}: ${input.fresh.newCount} new, ${input.fresh.changedCount} changed</p>
              <if=input.fresh.any>
                <ol class="whats-new-list">
                  <for|item| of=input.fresh.items>
                    <li class=["whats-new-item", `whats-new-${item.kind}`, `is-${item.freshness}`]>
                      <span class=["fresh-badge", `fresh-badge-${item.freshness}`]>${item.freshness === "new" ? "New" : "Changed"}</span><span class="whats-new-kind">${item.kind}</span>
                      <a class="whats-new-title" href=item.href>${item.title}</a>
                      <span class="whats-new-meta"><time datetime=item.at>${item.date}</time><if=(item.places.length > 0)>, at <for|pl, j| of=item.places><if=(j > 0)>, </if><a href=pl.href data-atlas-frame=pl.tag>${pl.tag}</a></for></if></span>
                    </li>
                  </for>
                </ol>
                <if=(input.fresh.more > 0)><p class="whats-new-more">And ${input.fresh.more} more.</p></if>
              </if>
              <else><p class="whats-new-none">Nothing new since your last visit.</p></else>
            </section>
          </if>
          <else>
            <section class="whats-new" aria-labelledby="whats-new-heading">
              <h2 class="section-label text-amber" id="whats-new-heading">What's new</h2>
              <p class="whats-new-none">What's new can't be read just now.</p>
            </section>
          </else>
          <nav class="atlas-list" aria-labelledby="atlas-list-heading">
            <h2 class="section-label text-amber" id="atlas-list-heading">Places on the map</h2>
            <for|region| of=regions by="id">
              <h3 class="atlas-list-region" id=`atlas-region-${region.id}`>${region.name}</h3>
              <ul class="atlas-list-places" aria-labelledby=`atlas-region-${region.id}`>
                <for|p| of=region.places by="tag">
                  <li><a class="atlas-row" href=p.href data-atlas-place=p.tag aria-current=(p.here ? "true" : undefined)><span class=["atlas-kind", `atlas-kind-${p.kind}`] aria-hidden="true"/><span class="atlas-row-tag">${p.tag}</span><span class="atlas-row-counts">${p.counts}</span><if=p.fresh><span class=["fresh-badge", `fresh-badge-${p.fresh}`]>${p.fresh === "new" ? "New" : "Changed"}</span></if></a></li>
                </for>
              </ul>
            </for>
          </nav>
        </aside>
      </div>
    </else>
  </div>
</section>
