/* What the page's head says (its route's `meta`, resolved by #lib/view.ts), drawn with Primate's
   <Head>: into the server's render, for a crawler or link preview that runs no script, and again
   in the browser after a client-side navigation, whose JSON carries a view's props but not the
   head. A view drawn without meta draws no head of its own.

   The tags come as HTML from headTags, escaped there, rather than as Marko tags: Marko leaves "<"
   and ">" in an attribute value as they are, and @primate/marko 0.13.1's server-side check of a
   <Head> misreads them ("List<String>" in a post's title) and fails the page (primate-bugs/15).
   Analytics isn't here: the browser would run a <Head>'s scripts again when it takes the page
   over (#lib/view.ts draws it). */
import { Head } from "@primate/marko/tags";
import { headTags, type Head as Meta } from "#lib/meta.ts";

export interface Input {
  meta?: Meta;
}

<if=input.meta>
  <Head>$!{headTags(input.meta)}</Head>
</if>
