export interface Input { post: { title: string; slug: string; excerpt: string; author: string; published: string; date: string; comments: number; audio?: boolean } }
<const/post=(input.post)>
<article class="group">
  <div class="byline text-muted-foreground/70 mb-2.5 flex items-center gap-2">
    <time datetime=post.published>${post.date}</time>
    <byline-comments count=post.comments/>
    <if=post.audio><audio-mark/></if>
  </div>
  <h3 class="headline-secondary text-foreground group-hover:text-amber transition-colors duration-200">
    <a href=`/posts/${post.slug}`>${post.title}</a>
  </h3>
  <if=post.excerpt><p class="text-muted-foreground text-sm leading-relaxed mt-2.5 line-clamp-3" data-masthead-dek="secondary">${post.excerpt}</p></if>
  <p class="byline text-muted-foreground/70 mt-3">By ${post.author}</p>
</article>
