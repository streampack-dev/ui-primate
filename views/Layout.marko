export interface Input {
  content: Marko.Body;
  siteName: string;
  brand: [string, string];
  factoids: boolean;
  rss: boolean;
  backendVersion: string;
  frontendVersion: string;
  sidebar: { id: string; title: string; slug: string }[];
  year: number;
  reader: { displayName: string } | null;
  admin: boolean;
  csrf: string;
  submit: boolean;
}

<div class="noise-overlay">
  <div class="relative flex min-h-screen flex-col">
    <header class="sticky top-0 z-50 w-full">
      <div class="h-[2px] bg-amber"/>
      <div class="bg-background/95 supports-[backdrop-filter]:bg-background/80 backdrop-blur border-b border-border/40">
        <!-- One row from md up, as before. On a phone, a signed-in reader's account links take a row of their
             own under the brand (an admin's Submit, Admin, name and Sign out don't fit beside it). -->
        <div class="container flex flex-wrap md:flex-nowrap min-h-14 md:h-14 py-1 md:py-0 max-w-screen-xl items-center gap-y-1">
          <div class="hidden md:flex items-center min-w-0">
            <a href="/" class="mr-6 flex items-center shrink-0">
              <span class="font-display text-xl tracking-normal">
                <span class="text-foreground">${input.brand[0]}</span><span class="text-amber">.</span><span class="text-foreground/80">${input.brand[1]}</span>
              </span>
            </a>
            <div class="h-5 w-px bg-border/40 mr-5 shrink-0"/>
            <nav class="flex items-center gap-5 min-w-0">
              <a href="/" class="section-label text-muted-foreground hover:text-amber transition-colors duration-200 whitespace-nowrap">Front Page</a>
              <a href="/tags" class="section-label text-muted-foreground hover:text-amber transition-colors duration-200 whitespace-nowrap">Tags</a>
              <a href="/atlas" class="section-label text-muted-foreground hover:text-amber transition-colors duration-200 whitespace-nowrap">Atlas</a>
            </nav>
          </div>
          <div class="md:hidden">
            <a href="/" class="flex items-center">
              <span class="font-display text-lg tracking-normal">
                <span class="text-foreground">${input.brand[0]}</span><span class="text-amber">.</span><span class="text-foreground/80">${input.brand[1]}</span>
              </span>
            </a>
          </div>
          <div class="flex items-center gap-1 ml-auto">
            <form action="/search" method="get" class="hidden lg:flex items-center gap-1 px-2">
              <label for="header-search" class="sr-only">Search posts</label>
              <span id="header-search-hint" class="sr-only">Use quotes for an exact word.</span>
              <input id="header-search" name="q" type="search" placeholder="Search posts..." aria-describedby="header-search-hint" title="Use quotes for an exact word"
                class="h-8 w-40 rounded border border-border/60 bg-background px-2 text-sm text-foreground placeholder:text-muted-foreground/75 focus:outline-none focus:ring-1 focus:ring-amber">
              <button type="submit" class="section-label text-muted-foreground hover:text-amber transition-colors duration-200" aria-label="Search">🔍</button>
            </form>
            <div class="hidden lg:block h-4 w-px bg-border/40"/>
            <a class="section-label text-muted-foreground hover:text-amber transition-colors duration-200 px-1.5 md:px-2" href="/feed.xml">RSS</a>
            <!-- The podcast (#33): the posts with recordings, as a feed for podcast players. -->
            <a class="section-label text-muted-foreground hover:text-amber transition-colors duration-200 px-1.5 md:px-2 inline-flex items-center gap-1" href="/podcast.xml" type="application/rss+xml" title="Subscribe to the ByteCode.News podcast (RSS feed)"><audio-icon/>Podcast</a>
            <div class="h-4 w-px bg-border/40"/>
            <!-- Lucide's sun and moon (ISC), as ui-nextjs has them: the sun in the dark, to go light, and the
                 moon in the light. The stylesheet shows the one for the theme the page is in. -->
            <button type="button" data-theme-toggle hidden aria-label="Toggle theme"
              class="theme-toggle inline-flex items-center justify-center w-9 h-9 text-muted-foreground hover:text-amber transition-colors duration-200 cursor-pointer">
              <svg class="icon-sun h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/>
                <path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
              </svg>
              <svg class="icon-moon h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"/>
              </svg>
            </button>
          </div>
          <!-- The account links: in line after a rule from md up; signed in, their own row on a phone. -->
          <div class=["flex items-center justify-end gap-1", input.reader ? "w-full md:w-auto" : "ml-auto md:ml-0"]>
            <div class="hidden md:block h-4 w-px bg-border/40"/>
            <if=input.submit><a href="/submit" class="section-label text-muted-foreground hover:text-amber transition-colors duration-200 px-1.5 md:px-2">Submit</a></if>
            <if=input.reader>
              <if=input.admin><a href="/admin" class="section-label text-muted-foreground hover:text-amber transition-colors duration-200 px-1.5 md:px-2">Admin</a></if>
              <a href="/profile" class="section-label text-muted-foreground hover:text-amber transition-colors duration-200 px-1.5 md:px-2 max-w-[10rem] truncate" title=input.reader.displayName>${input.reader.displayName}</a>
              <form method="post" action="/logout" class="inline-flex items-center">
                <input type="hidden" name="csrf" value=input.csrf>
                <button type="submit" class="section-label text-muted-foreground hover:text-amber transition-colors duration-200 px-1.5 md:px-2">Sign out</button>
              </form>
            </if>
            <else>
              <a href="/login" class="section-label text-muted-foreground hover:text-amber transition-colors duration-200 px-1.5 md:px-2">Log in</a>
            </else>
          </div>
        </div>
        <nav class="md:hidden flex items-center gap-4 overflow-x-auto px-6 pb-2">
          <a href="/" class="section-label text-muted-foreground hover:text-amber transition-colors whitespace-nowrap">Front Page</a>
          <a href="/tags" class="section-label text-muted-foreground hover:text-amber transition-colors whitespace-nowrap">Tags</a>
          <a href="/atlas" class="section-label text-muted-foreground hover:text-amber transition-colors whitespace-nowrap">Atlas</a>
          <form action="/search" method="get" class="flex items-center gap-1">
            <label for="mobile-header-search" class="sr-only">Search posts</label>
            <span id="mobile-header-search-hint" class="sr-only">Use quotes for an exact word.</span>
            <input id="mobile-header-search" name="q" type="search" placeholder="Search..." aria-describedby="mobile-header-search-hint" title="Use quotes for an exact word"
              class="h-8 w-28 rounded border border-border/60 bg-background px-2 text-sm text-foreground placeholder:text-muted-foreground/75 focus:outline-none focus:ring-1 focus:ring-amber">
            <button type="submit" class="section-label text-muted-foreground hover:text-amber transition-colors whitespace-nowrap" aria-label="Search">🔍</button>
          </form>
        </nav>
      </div>
    </header>

    <main class="flex-1"><${input.content}/></main>

    <footer class="border-t border-border/40">
      <div class="container max-w-screen-xl">
        <div class="border-t border-amber/30 mt-px"/>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 py-10">
          <div>
            <span class="font-display text-xl tracking-normal">
              <span class="text-foreground">bytecode</span><span class="text-amber">.</span><span class="text-foreground/80">news</span>
            </span>
            <p class="text-muted-foreground text-sm mt-3 leading-relaxed max-w-xs">
              Technical writing, software engineering insights, and the craft of building things that work.
            </p>
          </div>
          <div>
            <h2 class="section-label text-amber mb-4">Sections</h2>
            <nav class="flex flex-col gap-2">
              <a href="/" class="text-muted-foreground hover:text-foreground text-sm transition-colors">Articles</a>
              <a href="/atlas" class="text-muted-foreground hover:text-foreground text-sm transition-colors">Atlas</a>
              <if=input.factoids><a href="/factoids" class="text-muted-foreground hover:text-foreground text-sm transition-colors">Factoids</a></if>
              <if=input.rss><a href="/rss" class="text-muted-foreground hover:text-foreground text-sm transition-colors">RSS Reader</a></if>
              <a href="/karma" class="text-muted-foreground hover:text-foreground text-sm transition-colors">Karma</a>
              <a href="/logs" class="text-muted-foreground hover:text-foreground text-sm transition-colors">Logs</a>
              <for|post| of=input.sidebar>
                <a href=`/posts/${post.slug}` class="text-muted-foreground hover:text-foreground text-sm transition-colors">${post.title}</a>
              </for>
            </nav>
          </div>
          <div>
            <h2 class="section-label text-amber mb-4">System</h2>
            <div class="flex flex-col gap-2">
              <span class="dateline text-muted-foreground">Backend ${input.backendVersion}</span>
              <span class="dateline text-muted-foreground">Frontend ${input.frontendVersion}</span>
            </div>
          </div>
        </div>
        <div class="border-t border-border/40 py-5 flex flex-col sm:flex-row items-center justify-between gap-2">
          <p class="dateline text-muted-foreground">&copy; ${input.year} bytecode.news</p>
          <p class="dateline text-muted-foreground">All rights reserved</p>
        </div>
      </div>
    </footer>
  </div>
</div>
