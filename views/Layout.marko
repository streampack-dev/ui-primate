export interface Input {
  content: Marko.Body;
  siteName: string;
  brand: [string, string];
  factoids: boolean;
  rss: boolean;
  backendVersion: string;
  frontendVersion: string;
  sidebar: { id: string; title: string; slug: string }[];
  year: number;
  reader: { displayName: string } | null;
  admin: boolean;
  csrf: string;
}

<div class="noise-overlay">
  <div class="relative flex min-h-screen flex-col">
    <!-- The header (#95): one row at every width. From lg up: the brand, the sections (the rarer ones
         under More), search, the feeds under Subscribe, the theme, Submit as its one filled button,
         and the account. Below lg: the brand, Submit and a menu holding the rest. The menus are
         <details>, so they open without script; client/menus.ts closes them on Escape and outside. -->
    <header class="sticky top-0 z-50 w-full">
      <div class="h-[2px] bg-amber"/>
      <div class="bg-background/95 supports-[backdrop-filter]:bg-background/80 backdrop-blur border-b border-border/40">
        <div class="container flex h-14 max-w-screen-xl items-center gap-3 px-4 md:px-8">
          <a href="/" class="flex items-center shrink-0">
            <span class="font-display text-lg lg:text-xl tracking-normal whitespace-nowrap">
              <span class="text-foreground">${input.brand[0]}</span><span class="text-amber">.</span><span class="text-foreground/80">${input.brand[1]}</span>
            </span>
          </a>
          <div class="hidden lg:block h-5 w-px bg-border/40 ml-3 shrink-0"/>
          <nav class="hidden lg:flex items-center gap-5 ml-2" aria-label="Sections">
            <a href="/tags" class="section-label text-muted-foreground hover:text-amber transition-colors duration-200 whitespace-nowrap">Tags</a>
            <a href="/atlas" class="section-label text-muted-foreground hover:text-amber transition-colors duration-200 whitespace-nowrap">Atlas</a>
            <details class="hmenu relative" data-menu>
              <summary class="section-label text-muted-foreground hover:text-amber transition-colors duration-200 whitespace-nowrap">More<chevron/></summary>
              <div class="hmenu-panel left-0">
                <if=input.factoids><a class="hmenu-item" href="/factoids">Factoids</a></if>
                <if=input.rss><a class="hmenu-item" href="/rss">RSS Reader</a></if>
                <a class="hmenu-item" href="/karma">Karma</a>
                <a class="hmenu-item" href="/logs">Logs</a>
              </div>
            </details>
          </nav>
          <div class="hidden lg:flex items-center gap-4 ml-auto">
            <form action="/search" method="get" class="hidden xl:flex items-center gap-1">
              <label for="header-search" class="sr-only">Search posts</label>
              <span id="header-search-hint" class="sr-only">Use quotes for an exact word.</span>
              <input id="header-search" name="q" type="search" placeholder="Search posts..." aria-describedby="header-search-hint" title="Use quotes for an exact word"
                class="h-8 w-40 rounded border border-border/60 bg-background px-2 text-sm text-foreground placeholder:text-muted-foreground/75 focus:outline-none focus:ring-1 focus:ring-amber">
              <button type="submit" class="inline-flex items-center justify-center w-8 h-8 text-muted-foreground hover:text-amber transition-colors duration-200" aria-label="Search"><search-icon/></button>
            </form>
            <a href="/search" class="xl:hidden inline-flex items-center justify-center w-8 h-8 text-muted-foreground hover:text-amber transition-colors duration-200" aria-label="Search" title="Search"><search-icon/></a>
            <details class="hmenu relative" data-menu>
              <summary class="section-label text-muted-foreground hover:text-amber transition-colors duration-200 whitespace-nowrap">Subscribe<chevron/></summary>
              <div class="hmenu-panel right-0">
                <a class="hmenu-item" href="/feed.xml">RSS</a>
                <!-- The podcast (#33): the posts with recordings, as a feed for podcast players. -->
                <a class="hmenu-item inline-flex items-center gap-2" href="/podcast.xml" type="application/rss+xml" title="Subscribe to the ByteCode.News podcast (RSS feed)"><audio-icon/>Podcast</a>
              </div>
            </details>
            <theme-toggle/>
          </div>
          <!-- Submit for every reader (#92): where the site takes no anonymous posts, /submit signs them in first and brings them back. -->
          <a href="/submit" class="submit-button ml-auto lg:ml-0">Submit</a>
          <div class="hidden lg:flex items-center">
            <if=input.reader>
              <details class="hmenu relative" data-menu>
                <summary class="section-label text-muted-foreground hover:text-amber transition-colors duration-200 whitespace-nowrap" title=input.reader.displayName><span class="inline-block max-w-[8rem] truncate align-bottom">${input.reader.displayName}</span><chevron/></summary>
                <div class="hmenu-panel right-0">
                  <a class="hmenu-item" href="/profile">Profile</a>
                  <if=input.admin><a class="hmenu-item" href="/admin">Admin</a></if>
                  <form method="post" action="/logout">
                    <input type="hidden" name="csrf" value=input.csrf>
                    <button type="submit" class="hmenu-item">Sign out</button>
                  </form>
                </div>
              </details>
            </if>
            <else>
              <a href="/login" class="section-label text-muted-foreground hover:text-amber transition-colors duration-200 whitespace-nowrap">Log in</a>
            </else>
          </div>
          <details class="hmenu lg:hidden" data-menu>
            <summary class="inline-flex items-center justify-center w-9 h-9 text-muted-foreground hover:text-amber transition-colors duration-200" aria-label="Menu" title="Menu">
              <svg class="h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/></svg>
            </summary>
            <div class="hmenu-panel hmenu-sheet">
              <form action="/search" method="get" class="flex items-center gap-1 px-3 pb-2">
                <label for="mobile-header-search" class="sr-only">Search posts</label>
                <span id="mobile-header-search-hint" class="sr-only">Use quotes for an exact word.</span>
                <input id="mobile-header-search" name="q" type="search" placeholder="Search posts..." aria-describedby="mobile-header-search-hint" title="Use quotes for an exact word"
                  class="h-9 min-w-0 flex-1 rounded border border-border/60 bg-background px-2 text-sm text-foreground placeholder:text-muted-foreground/75 focus:outline-none focus:ring-1 focus:ring-amber">
                <button type="submit" class="inline-flex items-center justify-center w-9 h-9 text-muted-foreground hover:text-amber transition-colors duration-200" aria-label="Search"><search-icon/></button>
              </form>
              <nav aria-label="Sections">
                <a class="hmenu-item" href="/">Front Page</a>
                <a class="hmenu-item" href="/tags">Tags</a>
                <a class="hmenu-item" href="/atlas">Atlas</a>
                <if=input.factoids><a class="hmenu-item" href="/factoids">Factoids</a></if>
                <if=input.rss><a class="hmenu-item" href="/rss">RSS Reader</a></if>
                <a class="hmenu-item" href="/karma">Karma</a>
                <a class="hmenu-item" href="/logs">Logs</a>
              </nav>
              <p class="hmenu-heading">Subscribe</p>
              <a class="hmenu-item" href="/feed.xml">RSS</a>
              <a class="hmenu-item inline-flex items-center gap-2" href="/podcast.xml" type="application/rss+xml" title="Subscribe to the ByteCode.News podcast (RSS feed)"><audio-icon/>Podcast</a>
              <if=input.reader>
                <p class="hmenu-heading truncate" title=input.reader.displayName>${input.reader.displayName}</p>
                <a class="hmenu-item" href="/profile">Profile</a>
                <if=input.admin><a class="hmenu-item" href="/admin">Admin</a></if>
                <form method="post" action="/logout">
                  <input type="hidden" name="csrf" value=input.csrf>
                  <button type="submit" class="hmenu-item">Sign out</button>
                </form>
              </if>
              <else>
                <div class="hmenu-rule"/>
                <a class="hmenu-item" href="/login">Log in</a>
              </else>
              <div class="hmenu-rule"/>
              <div class="flex items-center gap-1 px-1"><theme-toggle/><span class="font-mono text-sm text-muted-foreground" aria-hidden="true">Light or dark</span></div>
            </div>
          </details>
        </div>
      </div>
    </header>

    <main class="flex-1"><${input.content}/></main>

    <footer class="border-t border-border/40">
      <div class="container max-w-screen-xl">
        <div class="border-t border-amber/30 mt-px"/>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 py-10">
          <div>
            <span class="font-display text-xl tracking-normal">
              <span class="text-foreground">bytecode</span><span class="text-amber">.</span><span class="text-foreground/80">news</span>
            </span>
            <p class="text-muted-foreground text-sm mt-3 leading-relaxed max-w-xs">
              Technical writing, software engineering insights, and the craft of building things that work.
            </p>
          </div>
          <div>
            <h2 class="section-label text-amber mb-4">Sections</h2>
            <nav class="flex flex-col gap-2">
              <a href="/" class="text-muted-foreground hover:text-foreground text-sm transition-colors">Articles</a>
              <a href="/atlas" class="text-muted-foreground hover:text-foreground text-sm transition-colors">Atlas</a>
              <if=input.factoids><a href="/factoids" class="text-muted-foreground hover:text-foreground text-sm transition-colors">Factoids</a></if>
              <if=input.rss><a href="/rss" class="text-muted-foreground hover:text-foreground text-sm transition-colors">RSS Reader</a></if>
              <a href="/karma" class="text-muted-foreground hover:text-foreground text-sm transition-colors">Karma</a>
              <a href="/logs" class="text-muted-foreground hover:text-foreground text-sm transition-colors">Logs</a>
              <for|post| of=input.sidebar>
                <a href=`/posts/${post.slug}` class="text-muted-foreground hover:text-foreground text-sm transition-colors">${post.title}</a>
              </for>
            </nav>
          </div>
          <div>
            <h2 class="section-label text-amber mb-4">System</h2>
            <div class="flex flex-col gap-2">
              <span class="dateline text-muted-foreground">Backend ${input.backendVersion}</span>
              <span class="dateline text-muted-foreground">Frontend ${input.frontendVersion}</span>
            </div>
          </div>
        </div>
        <div class="border-t border-border/40 py-5 flex flex-col sm:flex-row items-center justify-between gap-2">
          <p class="dateline text-muted-foreground">&copy; ${input.year} bytecode.news</p>
          <p class="dateline text-muted-foreground">All rights reserved</p>
        </div>
      </div>
    </footer>
  </div>
</div>
