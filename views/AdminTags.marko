export interface Input {
  meta?: import("#lib/meta.ts").Head;
  sections: { href: string; label: string; current: boolean; count?: number | null; countLabel?: string | null }[];
  csrf: string;
  section: "review" | "feed" | "aliases" | "stoplist" | "history";
  tabs: { label: string; href: string; current: boolean; count: number | null; countLabel: string }[];
  filters: { label: string; href: string; current: boolean }[];
  /** The list's own address, for its forms to come back to. */
  back: string;
  said?: string;
  error?: string;
  failed: boolean;
  empty: string;
  review: {
    id: string; tag: string; source: string; firstSeen: string; firstSeenAt: string; hint: string;
    ai: { candidate: string; percent: number | null; word: string | null; reason: string; model: string } | null;
    status: string; open: boolean; acted: string; aliasHref: string; splitHref: string;
  }[];
  feed: {
    name: string; written: string[]; status: string; waiting: boolean; counts: string; seen: string; decided: string;
    examples: { id: string; title: string; link: string; feed: string }[];
  }[];
  aliases: { alias: string; tag: string; by: string; removeHref: string }[];
  stops: { term: string; by: string }[];
  history: { key: string; action: string; subject: string; detail: string; actor: string; when: string; at: string }[];
  vocabulary: string[];
  pageLabel: string;
  countLabel: string;
  prev: string | null;
  next: string | null;
  term?: string;
}

<page-meta meta=input.meta/>
<admin-shell sections=input.sections>
  <nav class="admin-tabs flex flex-wrap gap-0 mb-4 border-b border-border/40" aria-label="Tag vocabulary">
    <for|t| of=input.tabs by="href">
      <a class=["admin-nav-link section-label", t.current && "is-current"] href=t.href aria-current=(t.current ? "page" : false)>${t.label}<if=t.count> <span class="admin-nav-count" aria-label=t.countLabel>${t.count}</span></if></a>
    </for>
  </nav>
  <if=input.filters.length>
    <nav class="tag-filters flex flex-wrap gap-x-4 gap-y-2 mb-6" aria-label="By status">
      <for|f| of=input.filters by="href">
        <a class=["section-label tag-filter", f.current && "is-current"] href=f.href aria-current=(f.current ? "page" : false)>${f.label}</a>
      </for>
    </nav>
  </if>
  <if=input.said><div class="mb-6 px-4 py-3 border border-amber/30 bg-amber/5"><p class="tag-notice text-sm text-foreground" role="status">${input.said}</p></div></if>
  <if=input.error><div class="mb-6 px-4 py-3 border border-destructive/30 bg-destructive/5"><p class="form-error mt-0" role="alert">${input.error}</p></div></if>
  <if=input.vocabulary.length>
    <datalist id="tag-vocabulary"><for|v| of=input.vocabulary><option value=v/></for></datalist>
  </if>

  <if=(input.section === "aliases")>
    <section class="border border-border/40 p-5 mb-8" aria-labelledby="add-alias-heading">
      <h2 class="section-label text-amber mb-2" id="add-alias-heading">Add an alias</h2>
      <p class="text-muted-foreground text-sm mb-4">Whatever already carries the alias is re-pointed to the tag it means. You'll see what it would re-point before it's done.</p>
      <form class="grid grid-cols-1 sm:grid-cols-[1fr_1fr_auto] gap-4 items-end" method="get" action="/admin/tags/aliases/new">
        <div>
          <label class="byline form-label" for="new-alias">Alias</label>
          <input class="form-field text-sm p-2" id="new-alias" name="alias" required autocomplete="off">
        </div>
        <div>
          <label class="byline form-label" for="new-alias-tag">Means</label>
          <input class="form-field text-sm p-2" id="new-alias-tag" name="tag" required autocomplete="off" list=(input.vocabulary.length ? "tag-vocabulary" : false)>
        </div>
        <button type="submit" class="auth-button">Preview…</button>
      </form>
    </section>
  </if>
  <if=(input.section === "stoplist")>
    <section class="border border-border/40 p-5 mb-8" aria-labelledby="add-stop-heading">
      <h2 class="section-label text-amber mb-2" id="add-stop-heading">Stoplist a term</h2>
      <p class="text-muted-foreground text-sm mb-4">A stoplisted term is dropped from tags written from now on; tags already written keep it.</p>
      <form class="grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-4 items-end" method="post" action="/admin/tags/stoplist">
        <input type="hidden" name="csrf" value=input.csrf>
        <div>
          <label class="byline form-label" for="new-stop">Term</label>
          <input class="form-field text-sm p-2" id="new-stop" name="term" required autocomplete="off" value=(input.term ?? "")>
        </div>
        <button type="submit" class="auth-button">Stoplist</button>
      </form>
    </section>
  </if>

  <if=input.failed><p class="form-error" role="alert">The tag vocabulary can't be loaded just now. Try again shortly.</p></if>
  <else if=(input.section === "review" && input.review.length)>
    <for|r, i| of=input.review by="id">
      <article class=["tag-review py-6", i > 0 && "border-t border-border/30"] id=`review-${r.id}`>
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <h2 class="headline-brief text-foreground mb-1"><span class="as-typed">${r.tag}</span></h2>
          <span class=["tag-status section-label", r.open && "text-amber"]>${r.status}</span>
        </div>
        <p class="tag-seen byline text-muted-foreground">From ${r.source}, first seen <time datetime=r.firstSeenAt>${r.firstSeen}</time></p>
        <p class="tag-hint text-sm mt-3">${r.hint}</p>
        <if=r.ai>
          <p class="tag-ai text-sm mt-2"><strong>AI suggests <span class="as-typed">“${r.ai.candidate}”</span></strong><if=(r.ai.percent !== null)>: ${r.ai.percent}% sure (${r.ai.word})</if>.<if=r.ai.reason> ${r.ai.reason}</if><if=r.ai.model> <span class="text-muted-foreground">(${r.ai.model})</span></if></p>
        </if>
        <else><p class="tag-ai text-sm mt-2 text-muted-foreground">No AI suggestion</p></else>
        <if=r.acted><p class="tag-acted byline text-muted-foreground mt-2">${r.acted}</p></if>
        <if=r.open>
          <div class="tag-actions flex flex-wrap items-center gap-2 mt-4">
            <a class="auth-button tag-alias" href=r.aliasHref>Alias to…</a>
            <a class="section-label profile-action tag-split" href=r.splitHref>Split into…</a>
            <form class="flex flex-wrap gap-2" method="post" action=`/admin/tags/review/${r.id}/keep`>
              <input type="hidden" name="csrf" value=input.csrf>
              <input type="hidden" name="back" value=input.back>
              <button type="submit" class="section-label profile-action">Keep</button>
              <button type="submit" class="section-label profile-action danger" formaction=`/admin/tags/review/${r.id}/dismiss`>Dismiss</button>
            </form>
          </div>
        </if>
      </article>
    </for>
  </else>
  <else if=(input.section === "feed" && input.feed.length)>
    <for|t, i| of=input.feed by="name">
      <article class=["tag-feed py-6", i > 0 && "border-t border-border/30"] id=`feed-${i}`>
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <h2 class="headline-brief text-foreground mb-1"><span class="as-typed">${t.name}</span></h2>
          <span class=["tag-status section-label", t.waiting && "text-amber"]>${t.status}</span>
        </div>
        <if=t.written.length><p class="tag-written byline text-muted-foreground">Written as <for|w, j| of=t.written><if=j>, </if><span class="as-typed">${w}</span></for></p></if>
        <p class="tag-counts text-sm mt-2">${t.counts}</p>
        <p class="tag-seen byline text-muted-foreground mt-1">${t.seen}</p>
        <if=t.decided><p class="tag-acted byline text-muted-foreground mt-2">${t.decided}</p></if>
        <if=t.examples.length>
          <ul class="tag-examples mt-3 space-y-1 text-sm list-none p-0" aria-label=`Entries carrying ${t.name}`>
            <for|x| of=t.examples by="id">
              <li><if=x.link><a class="pagelink" href=x.link rel="nofollow noopener">${x.title}</a></if><else>${x.title}</else> <span class="text-muted-foreground">from ${x.feed}</span></li>
            </for>
          </ul>
        </if>
        <if=t.waiting>
          <form class="tag-feed-form flex flex-wrap items-end gap-2 mt-4" method="post" action="/admin/tags/feed/map">
            <input type="hidden" name="csrf" value=input.csrf>
            <input type="hidden" name="back" value=input.back>
            <input type="hidden" name="name" value=t.name>
            <div>
              <label class="byline form-label" for=`map-${i}`>Map “${t.name}” to</label>
              <input class="form-field text-sm p-2" id=`map-${i}` name="tag" required autocomplete="off" list=(input.vocabulary.length ? "tag-vocabulary" : false)>
            </div>
            <button type="submit" class="auth-button">Map</button>
            <button type="submit" class="section-label profile-action" formaction="/admin/tags/feed/create" formnovalidate>Create</button>
            <button type="submit" class="section-label profile-action danger" formaction="/admin/tags/feed/ignore" formnovalidate>Ignore</button>
          </form>
        </if>
      </article>
    </for>
  </else>
  <else if=(input.section === "aliases" && input.aliases.length)>
    <ul class="tag-aliases list-none p-0">
      <for|a, i| of=input.aliases by="alias">
        <li class=["tag-alias-row py-4 flex items-start justify-between gap-4 flex-wrap", i > 0 && "border-t border-border/30"]>
          <div class="min-w-0">
            <p class="text-foreground"><span class="as-typed">${a.alias}</span> means <span class="as-typed">${a.tag}</span></p>
            <p class="byline text-muted-foreground">Added by ${a.by}</p>
          </div>
          <a class="section-label profile-action danger" data-confirm href=a.removeHref>Remove<span class="sr-only"> the alias ${a.alias}</span>…</a>
        </li>
      </for>
    </ul>
  </else>
  <else if=(input.section === "stoplist" && input.stops.length)>
    <ul class="tag-stops list-none p-0">
      <for|s, i| of=input.stops by="term">
        <li class=["tag-stop-row py-4 flex items-start justify-between gap-4 flex-wrap", i > 0 && "border-t border-border/30"]>
          <div class="min-w-0">
            <p class="as-typed">${s.term}</p>
            <p class="byline text-muted-foreground">Added by ${s.by}</p>
          </div>
          <form method="post" action="/admin/tags/stoplist/remove">
            <input type="hidden" name="csrf" value=input.csrf>
            <input type="hidden" name="term" value=s.term>
            <button type="submit" class="section-label profile-action danger">Remove<span class="sr-only"> ${s.term} from the stoplist</span></button>
          </form>
        </li>
      </for>
    </ul>
  </else>
  <else if=(input.section === "history" && input.history.length)>
    <ol class="tag-history list-none p-0">
      <for|h, i| of=input.history by="key">
        <li class=["tag-history-row py-3", i > 0 && "border-t border-border/30"]>
          <p class="text-sm"><strong>${h.action}</strong> <span class="as-typed">${h.subject}</span><if=h.detail> <span class="text-muted-foreground">(${h.detail})</span></if></p>
          <p class="byline text-muted-foreground">by ${h.actor}, <time datetime=h.at>${h.when}</time></p>
        </li>
      </for>
    </ol>
  </else>
  <else><p class="tag-empty py-12 text-center section-label form-label-text">${input.empty}</p></else>

  <if=(input.section === "review" || input.section === "feed")>
    <if=!input.failed>
      <p class="tag-page byline text-muted-foreground mt-8">${input.pageLabel}<if=input.countLabel> (${input.countLabel})</if></p>
    </if>
    <div class="pagination mt-4">
      <div><if=input.prev><a class="pagelink" rel="prev" href=input.prev>&larr; Previous</a></if></div>
      <div><if=input.next><a class="pagelink" rel="next" href=input.next>Next &rarr;</a></if></div>
    </div>
  </if>
</admin-shell>
