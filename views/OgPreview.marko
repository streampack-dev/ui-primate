export interface Input { cards: { image: string; url: string; title: string; description: string }[] }
<section class="py-8 md:py-12">
  <div class="max-w-2xl mx-auto px-6 md:px-8">
    <div class="border-t-2 border-amber mb-6"/>
    <h1 class="font-display text-3xl mb-2">Link previews</h1>
    <p class="text-muted-foreground text-sm mb-8">How shared links appear on X, LinkedIn, Slack, Discord and the like.</p>
    <for|card| of=input.cards by="image">
      <figure class="og-card">
        <img src=card.image width="1200" height="630" alt=`Preview card: ${card.title}` loading="lazy">
        <figcaption>
          <span class="og-card-url">${card.url}</span>
          <span class="og-card-title">${card.title}</span>
          <span class="og-card-description">${card.description}</span>
        </figcaption>
      </figure>
    </for>
  </div>
</section>
