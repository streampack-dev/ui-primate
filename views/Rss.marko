export interface Input {
  meta?: import("#lib/meta.ts").Head;
  feed: string;
  title: string;
  feeds: { value: string; label: string }[];
  rates: boolean;
  csrf: string;
  back: string;
  rating: string;
  ratingNote: string;
  ratings: { value: string; label: string }[];
  filters: { value: string; label: string }[];
  listing: boolean;
  list: { title: string; feedUrl: string; siteUrl: string }[];
  count: string;
  filtered: boolean;
  refresh: string;
  newest: string;
  items: { id: string; title: string; link: string; published: string; date: string; summary: string; anchor?: string; rating?: string; said?: string }[];
  prev: string | null;
  next: string | null;
}

<page-meta meta=input.meta/>
<section class="py-8 md:py-12">
  <div class="max-w-4xl mx-auto px-6 md:px-8">
    <header class="mb-10">
      <div class="border-t-2 border-amber animate-rule-draw"/>
      <div class="pt-6 pb-8 border-b border-border/40">
        <p class="section-label text-amber mb-3">Subscribed Sources</p>
        <h1 class="font-display text-foreground leading-tight submit-title">RSS Reader</h1>
        <p class="text-muted-foreground text-sm mt-3 leading-relaxed max-w-2xl">
          Browse stored RSS items across subscribed feeds. Filter by feed title or URL, and narrow results by entry title.
        </p>
      </div>
    </header>

    <form class=(input.rates ? "rss-filter grid grid-cols-1 md:grid-cols-[1fr_1fr_auto_auto] gap-3 items-end mb-8" : "rss-filter grid grid-cols-1 md:grid-cols-[1fr_1fr_auto] gap-3 items-end mb-8") action="/rss" method="get">
      <label class="section-label form-label-text">
        Feed title or URL
        <select class="form-field text-sm p-2 mt-2" name="feed">
          <option value="" selected=!input.feed>All feeds</option>
          <for|f| of=input.feeds by="value">
            <option value=f.value selected=(f.value === input.feed)>${f.label}</option>
          </for>
        </select>
      </label>
      <label class="section-label form-label-text">
        Entry title contains
        <input class="form-field text-sm p-2 mt-2" name="title" type="search" placeholder="spring" value=input.title>
      </label>
      <if=input.rates>
        <label class="section-label form-label-text">
          Rating
          <select class="rss-rating-filter form-field text-sm p-2 mt-2" name="rating">
            <for|f| of=input.filters by="value">
              <option value=f.value selected=(f.value === input.rating)>${f.label}</option>
            </for>
          </select>
        </label>
      </if>
      <button class="section-label rss-filter-button" type="submit">Filter</button>
    </form>

    <div class="flex items-center justify-between gap-4 border-b border-border/40 pb-3 mb-6">
      <p class="dateline text-muted-foreground"><span class="rss-count">${input.count}</span><if=input.newest> · <span class="rss-newest">${input.newest}</span></if></p>
      <span class="flex gap-4">
        <if=input.listing><a class="rss-items-link section-label form-helper" href="/rss">Back to Items</a></if>
        <else><a class="rss-feed-list-link section-label form-helper hidden md:inline" href="/rss?view=feeds">Feed List</a></else>
        <if=input.filtered><a class="rss-clear section-label form-helper" href="/rss">Clear Filters</a></if>
        <a class="rss-refresh section-label form-helper" href=input.refresh>Refresh</a>
      </span>
    </div>

    <if=input.ratingNote><p class="rss-rating-note form-error mb-6" role="status">${input.ratingNote}</p></if>
    <if=input.listing>
      <section class="rss-feeds" aria-labelledby="rss-feeds-heading">
        <h2 id="rss-feeds-heading" class="section-label text-muted-foreground mb-4">Feed List</h2>
        <if=(input.list.length === 0)>
          <p class="py-12 text-center text-muted-foreground font-mono text-sm">No feeds on this page.</p>
        </if>
        <else>
          <ul class="rss-feed-list divide-y divide-border/30">
            <for|f| of=input.list by="feedUrl">
              <li class="rss-feed-row py-3 text-sm">
                <if=f.title>
                  <if=f.siteUrl><a class="rss-feed-title text-foreground hover:text-amber transition-colors" href=f.siteUrl rel="noopener noreferrer">${f.title}</a></if>
                  <else><span class="rss-feed-title text-foreground">${f.title}</span></else>
                  ${" - "}
                </if>
                <span class="rss-feed-url font-mono break-all">${f.feedUrl}</span>
              </li>
            </for>
          </ul>
        </else>
      </section>
    </if>
    <else if=(input.items.length === 0)>
      <p class="py-12 text-center text-muted-foreground font-mono text-sm">No RSS items matched these filters.</p>
    </else>
    <else>
      <div class="divide-y divide-border/30">
        <for|i| of=input.items by="id">
          <article class="rss-item group py-5" id=(i.anchor || false)>
            <a class="rss-item-title headline-brief text-foreground group-hover:text-amber transition-colors"
              href=i.link target="_blank" rel="noopener noreferrer" data-rss-access=(i.id || false)>${i.title}</a>
            <div class="rss-item-meta mt-3 flex flex-wrap gap-x-4 gap-y-1">
              <span class="break-all">${i.link}</span>
              <span aria-hidden="true">|</span>
              <if=i.published><time datetime=i.published>${i.date}</time></if>
              <else><span>${i.date}</span></else>
            </div>
            <if=i.summary><p class="rss-summary">${i.summary}</p></if>
            <if=input.rates>
              <div class="rss-rating mt-3 flex flex-wrap items-center gap-2" role="group" aria-label=`Rate “${i.title}”` data-rss-rating=i.id>
                <for|r| of=input.ratings by="value">
                  <form class="rss-rate" method="post" action=`/admin/rss/items/${i.id}/rating`>
                    <input type="hidden" name="csrf" value=input.csrf>
                    <input type="hidden" name="back" value=input.back>
                    <button class="rss-rate-button section-label" type="submit" name="rating" value=(i.rating === r.value ? "NONE" : r.value)
                      aria-pressed=(i.rating === r.value ? "true" : "false") data-rating=r.value>
                      <span class="rss-rate-glyph" aria-hidden="true">${i.rating === r.value ? "✓" : "○"}</span> ${r.label}
                    </button>
                  </form>
                </for>
                <span class="rss-rating-now dateline text-muted-foreground" aria-live="polite">${i.said}</span>
              </div>
            </if>
          </article>
        </for>
      </div>
    </else>

    <div class="pagination mt-8">
      <div><if=input.prev><a class="pagelink" rel="prev" href=input.prev>&larr; Previous</a></if></div>
      <div><if=input.next><a class="pagelink" rel="next" href=input.next>Next &rarr;</a></if></div>
    </div>
  </div>
</section>
