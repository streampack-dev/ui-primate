export interface Input {
  tag: string;
  count: string;
  posts: any[];
  pages: string;
  prev: string | null;
  next: string | null;
}
<section class="py-8 md:py-12">
  <div class="max-w-3xl mx-auto px-6 md:px-8">
    <header class="mb-10">
      <div class="border-t-2 border-amber animate-rule-draw"/>
      <div class="pt-6 pb-8 border-b border-border/40">
        <nav class="flex items-center gap-2 mb-3" aria-label="Breadcrumb">
          <a class="section-label form-helper" href="/tags">Tags</a>
          <span class="section-label text-muted-foreground" aria-hidden="true">/</span>
          <span class="section-label text-amber" aria-current="page">#${input.tag}</span>
        </nav>
        <h1 class="font-display text-foreground leading-tight submit-title">#${input.tag}</h1>
        <p class="tag-count text-muted-foreground text-sm mt-2">${input.count}</p>
      </div>
    </header>
    <if=(input.posts.length === 0)>
      <div class="py-12 text-center">
        <p class="section-label form-label-text mb-3">No articles yet</p>
        <p class="text-muted-foreground text-sm">Check back soon for content with this tag.</p>
      </div>
    </if>
    <else>
      <for|p, i| of=input.posts by="id"><post-row row=p first=(i === 0)/></for>
    </else>
    <list-pager pages=input.pages prev=input.prev next=input.next/>
  </div>
</section>
