export interface Input {
  page: number;
  totalPages: number;
  posts: any[];
  popular: any[];
  dateline: string;
}
<const/first=(input.page === 0)>
<const/lead=(input.posts[0])>
<const/secondary=(input.posts.slice(1, 3))>
<const/belowFold=(input.posts.slice(3, 9))>

<if=first>
  <section class="border-b border-border/30">
    <div class="container max-w-screen-xl">
      <div class="border-t-[3px] border-amber animate-rule-draw"/>
      <div class="relative isolate overflow-hidden py-10 md:py-14 text-center">
        <div aria-hidden="true" class="masthead-ambient">
          <svg class="masthead-art" viewBox="0 0 1200 320" preserveAspectRatio="none" focusable="false"/>
        </div>
        <div class="relative z-10">
          <p class="dateline text-amber-dim/70 mb-4 animate-fade-in" style="animation-delay: 100ms">${input.dateline}</p>
          <h1 class="masthead-name text-foreground animate-press-in" style="animation-delay: 200ms">
            <a href="/" aria-label="Go to front page">bytecode<span class="text-amber">.</span>news</a>
          </h1>
          <div class="flex items-center justify-center gap-4 mt-5 animate-fade-in" style="animation-delay: 400ms">
            <div class="h-px w-12 bg-amber/20"/>
            <p class="section-label text-muted-foreground/50">Programming News &amp; Technical Writing</p>
            <div class="h-px w-12 bg-amber/20"/>
          </div>
        </div>
      </div>
      <div class="border-t border-amber/30"/>
      <div class="border-t border-amber/30 mt-px"/>
    </div>
  </section>
</if>

<section class="container max-w-screen-xl py-8 md:py-12">
  <div class="flex items-center gap-4 mb-8">
    <span class="section-label text-amber font-medium">Latest Dispatches</span>
    <div class="flex-1 border-t border-border/40"/>
  </div>
  <if=input.posts.length === 0>
    <div class="animate-fade-in py-16 max-w-md mx-auto text-center">
      <div class="border-t-2 border-amber/30 mb-8"/>
      <p class="section-label text-amber/60 mb-4">Notice</p>
      <p class="font-display text-2xl text-foreground/80 tracking-tight leading-snug">The editorial team is preparing the first edition.</p>
      <p class="text-muted-foreground/50 text-sm mt-4 leading-relaxed">Articles will appear here once published. Check back soon for technical writing, engineering insights, and dispatches from the world of software.</p>
      <div class="border-t-2 border-amber/30 mt-8"/>
    </div>
  </if>
  <else>
    <div class="animate-press-in">
      <if=first>
        <div class="grid grid-cols-1 md:grid-cols-5 gap-0">
          <if=lead><div class="md:col-span-3 md:border-r md:border-border/30 md:pr-8"><lead-card post=lead/></div></if>
          <if=secondary.length>
            <div class="md:col-span-2 md:pl-8 mt-8 md:mt-0">
              <for|post, i| of=secondary>
                <div class=(i > 0 ? "border-t border-border/30 pt-6 mt-6" : "")><secondary-card post=post/></div>
              </for>
            </div>
          </if>
        </div>
        <if=belowFold.length>
          <div class="my-10 relative">
            <div class="border-t-2 border-amber/30"/>
            <span class="section-label text-amber absolute left-0 -top-2.5 bg-background px-2 pl-0">More Stories</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-0">
            <for|post, i| of=belowFold>
              <div class="border-t border-border/20 py-6 first:border-t-0 sm:[&:nth-child(-n+2)]:border-t-0 lg:[&:nth-child(-n+3)]:border-t-0" style=`animation-delay: ${(i + 3) * 80}ms`><brief-card post=post/></div>
            </for>
          </div>
        </if>
        <pagination page=input.page totalPages=input.totalPages/>
        <if=input.popular.length>
          <aside class="mt-10">
            <div class="my-10 relative">
              <div class="border-t-2 border-amber/30"/>
              <span class="section-label text-amber absolute left-0 -top-2.5 bg-background px-2 pl-0">Popular Reads</span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
              <for|post, index| of=input.popular>
                <article class="group">
                  <p class="dateline text-muted-foreground/50 mb-2">${String(index + 1).padStart(2, "0")}</p>
                  <h3 class="headline-brief text-foreground group-hover:text-amber transition-colors duration-200"><a href=`/posts/${post.slug}`>${post.title}</a></h3>
                  <if=post.excerpt><p class="text-muted-foreground/70 text-sm leading-relaxed mt-2 line-clamp-3" data-popular-dek>${post.excerpt}</p></if>
                  <div class="byline text-muted-foreground/60 mt-2 flex items-center gap-2">
                    <span>${post.author}</span>
                    <span class="text-border/50">|</span>
                    <time datetime=post.published>${post.date}</time>
                  </div>
                </article>
              </for>
            </div>
          </aside>
        </if>
      </if>
      <else>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-0">
          <for|post, i| of=input.posts>
            <div class="border-t border-border/20 py-6 first:border-t-0 sm:[&:nth-child(-n+2)]:border-t-0 lg:[&:nth-child(-n+3)]:border-t-0" style=`animation-delay: ${i * 80}ms`><brief-card post=post/></div>
          </for>
        </div>
        <pagination page=input.page totalPages=input.totalPages/>
      </else>
    </div>
  </else>
</section>
