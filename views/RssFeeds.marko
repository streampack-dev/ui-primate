export interface Input {
  meta?: import("#lib/meta.ts").Head;
  q: string;
  count: string;
  feeds: { title: string; feedUrl: string; siteUrl: string; items: string; latest: string; latestDate: string; command: string }[];
}

<page-meta meta=input.meta/>
<section class="py-8 md:py-12">
  <div class="max-w-4xl mx-auto px-6 md:px-8">
    <header class="mb-10">
      <div class="border-t-2 border-amber animate-rule-draw"/>
      <div class="pt-6 pb-8 border-b border-border/40">
        <p class="section-label text-amber mb-3"><a class="form-helper" href="/rss">RSS Reader</a></p>
        <h1 class="font-display text-foreground leading-tight submit-title">All Feeds</h1>
        <p class="text-muted-foreground text-sm mt-3 leading-relaxed max-w-2xl">
          Every feed the site follows. To follow one in an IRC channel, give the bot
          <code class="font-mono">feed subscribe</code> and the feed's address.
        </p>
      </div>
    </header>

    <form class="feeds-filter rss-filter grid grid-cols-1 md:grid-cols-[1fr_auto] gap-3 items-end mb-8" action="/rss/feeds" method="get" role="search">
      <label class="section-label form-label-text">
        Feed title or address contains
        <input class="form-field text-sm p-2 mt-2" name="q" type="search" placeholder="java" value=input.q>
      </label>
      <button class="section-label rss-filter-button" type="submit">Filter</button>
    </form>

    <div class="flex items-center justify-between gap-4 border-b border-border/40 pb-3 mb-6">
      <p class="dateline text-muted-foreground feeds-count">${input.count}</p>
      <if=input.q><a class="feeds-clear section-label form-helper" href="/rss/feeds">Clear Filter</a></if>
    </div>

    <if=(input.feeds.length === 0)>
      <p class="py-12 text-center text-muted-foreground font-mono text-sm">No feeds matched this filter.</p>
    </if>
    <else>
      <ul class="feeds-list divide-y divide-border/30">
        <for|f| of=input.feeds by="feedUrl">
          <li class="feed-row py-5">
            <h2 class="feed-title headline-brief text-foreground">
              <if=f.siteUrl><a class="hover:text-amber transition-colors" href=f.siteUrl rel="noopener noreferrer">${f.title}</a></if>
              <else>${f.title}</else>
            </h2>
            <p class="rss-item-meta mt-2 flex flex-wrap gap-x-4 gap-y-1">
              <span class="feed-items">${f.items}</span>
              <if=f.latest>
                <span aria-hidden="true">|</span>
                <span>latest <time class="feed-latest" datetime=f.latest>${f.latestDate}</time></span>
              </if>
            </p>
            <dl class="feed-fields mt-3">
              <dt class="section-label form-label-text">Feed address</dt>
              <dd><code class="feed-url">${f.feedUrl}</code></dd>
              <dt class="section-label form-label-text">IRC</dt>
              <dd class="feed-command-row">
                <code class="feed-command">${f.command}</code>
                <button class="feed-copy section-label form-helper" type="button" hidden data-copy=f.command><span class="feed-copy-word">Copy</span><span class="sr-only"> the command for ${f.title}</span></button>
                <span class="feed-copied rss-item-meta" role="status"></span>
              </dd>
            </dl>
          </li>
        </for>
      </ul>
    </else>
  </div>
</section>
