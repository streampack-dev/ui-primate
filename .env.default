# ui-primate settings for local development. Copy to .env (git-ignored) and fill in what's empty;
# `just dev` and `just run` load .env (builds and tests never do).

# The API. Default: the live API, read-only for anyone not signed in.
# BCN_API_BASE=https://api.bytecode.news

# Readers' sessions, in a database of ui-primate's own on streampack's local Postgres
# (`just create-db` makes it). Never streampack's own database: ui-primate's tables would sit
# among streampack's, and the app refuses to start. Unset, sessions are kept in memory.
BCN_DB_URL=postgres://nevet:nevet@localhost:5432/ui_primate

# Seals readers' API tokens in their sessions; changing it signs everyone out.
# Any long random string: openssl rand -base64 48
SESSION_SECRET=
